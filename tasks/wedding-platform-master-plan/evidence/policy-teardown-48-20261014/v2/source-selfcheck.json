        {
          "operation": "add",
          "newLine": 59,
          "text": "export function bindCapturedCase(item, capture, browser, journal, augment = false) {"
        },
        {
          "operation": "add",
          "newLine": 60,
          "text": "  assert([capture?.phases, capture?.requests, capture?.responses, capture?.finished].every(Array.isArray), 'CAPTURE_SOURCE_ARRAYS_REQUIRED');"
        },
        {
          "operation": "add",
          "newLine": 61,
          "text": "  const ownJournal = journal.cases.filter(row => row.caseId === item.caseId);"
        },
        {
          "operation": "add",
          "newLine": 62,
          "text": "  assert(ownJournal.length === 1 && capture.phases.every(phase => phase.caseId === item.caseId), 'CAPTURE_OWN_CASE_PHASE_SOURCE');"
        },
        {
          "operation": "add",
          "newLine": 63,
          "text": "  const proofs = capture.phases.map(phase => ({caseId: phase.caseId, name: phase.name, startedAt: phase.startedAt, finishedAt: phase.finishedAt, captured: phase.captured}));"
        },
        {
          "operation": "add",
          "newLine": 64,
          "text": "  if (augment) ownJournal[0].phaseProofs = proofs;"
        },
        {
          "operation": "add",
          "newLine": 65,
          "text": "  else assert(JSON.stringify(ownJournal[0].phaseProofs) === JSON.stringify(proofs), 'CAPTURE_JOURNAL_PHASE_PROOFS_CHANGED');"
        },
        {
          "operation": "add",
          "newLine": 66,
          "text": "  const projectedRequests = browser.requests.filter(row => row.caseId === item.caseId);"
        },
        {
          "operation": "add",
          "newLine": 67,
          "text": "  const actualAPIRequests = capture.requests.filter(row => row.caseId === item.caseId && new URL(row.url).pathname.startsWith('/api/'));"
        },
        {
          "operation": "add",
          "newLine": 68,
          "text": "  assert(actualAPIRequests.length === projectedRequests.length, 'CAPTURE_ALL_API_REQUESTS_REQUIRED');"
        },
        {
          "operation": "add",
          "newLine": 69,
          "text": "  for (const request of projectedRequests) {"
        },
        {
          "operation": "add",
          "newLine": 70,
          "text": "    const originalID = request.originalRequestId;"
        },
        {
          "operation": "add",
          "newLine": 71,
          "text": "    assert(Number.isInteger(originalID) && request.id === item.caseId + ':' + originalID, 'CAPTURE_API_ORIGINAL_ID_BINDING');"
        },
        {
          "operation": "add",
          "newLine": 72,
          "text": "    const requests = capture.requests.filter(row => row.caseId === item.caseId && row.id === originalID);"
        },
        {
          "operation": "add",
          "newLine": 73,
          "text": "    const responses = capture.responses.filter(row => row.caseId === item.caseId && row.id === originalID);"
        },
        {
          "operation": "add",
          "newLine": 74,
          "text": "    const finishes = capture.finished.filter(row => row.caseId === item.caseId && row.id === originalID);"
        },
        {
          "operation": "add",
          "newLine": 75,
          "text": "    const responseRows = browser.responses.filter(row => row.id === request.id), finishRows = browser.finished.filter(row => row.id === request.id);"
        },
        {
          "operation": "add",
          "newLine": 76,
          "text": "    assert(requests.length === 1 && responses.length === 1 && finishes.length === 1 && responseRows.length === 1 && finishRows.length === 1, 'CAPTURE_API_RECORD_BIJECTION');"
        },
        {
          "operation": "add",
          "newLine": 77,
          "text": "    const source = requests[0], sourceResponse = responses[0], sourceFinish = finishes[0], response = responseRows[0], finish = finishRows[0];"
        },
        {
          "operation": "add",
          "newLine": 78,
          "text": "    assert(response.originalRequestId === originalID && finish.originalRequestId === originalID && response.caseId === item.caseId && finish.caseId === item.caseId, 'CAPTURE_RESPONSE_OR_FINISH_ID_BINDING');"
        },
        {
          "operation": "add",
          "newLine": 79,
          "text": "    assert(source.phase === request.phase && source.at === request.at && source.method === request.method && source.url === request.url && endpoint(new URL(source.url).pathname) === request.path && source.probeCookieObserved === true && request.probeCookieObserved === true && digest(source.caseCookieSHA256) === digest(request.caseCookieSHA256) && digest(source.caseCookieSHA256) === digest(ownJournal[0].caseCookieSHA256), 'CAPTURE_API_REQUEST_PROOF_CHANGED');"
        },
        {
          "operation": "add",
          "newLine": 80,
          "text": "    assert(sourceResponse.status === response.status && sourceResponse.at === response.at && digest(sourceResponse.bodySHA256) === digest(response.bodySHA256) && sourceResponse.bodyByteLength === response.bodyBytes && sourceFinish.at === finish.at, 'CAPTURE_API_RESPONSE_OR_FINISH_PROOF_CHANGED');"
        },
        {
          "operation": "add",
          "newLine": 81,
          "text": "    const phases = capture.phases.filter(phase => phase.caseId === item.caseId && phase.name === source.phase);"
        },
        {
          "operation": "add",
          "newLine": 82,
          "text": "    assert(phases.length === 1 && phases[0].captured === true && Array.isArray(phases[0].requestIds) && phases[0].requestIds.includes(originalID), 'CAPTURED_PHASE_ORIGINAL_REQUEST_IDENTITY');"
        },
        {
          "operation": "add",
          "newLine": 83,
          "text": "    const fields = {phaseStartedAt: phases[0].startedAt, phaseFinishedAt: phases[0].finishedAt, phaseCaptured: phases[0].captured};"
