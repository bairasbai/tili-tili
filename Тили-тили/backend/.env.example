# Копировать в .env и заполнить. Значения в репозиторий не попадают НИКОГДА.
# .env в .gitignore — это не рекомендация, а условие.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Источник запросов фронта. Через запятую, без слеша на конце.
CORS_ORIGINS=http://localhost:5173,https://tili-tili.ru

# PostgreSQL 16. В проде — управляемая БД Timeweb, площадка СПб или Москва.
DATABASE_URL=postgres://tili:tili@localhost:5432/tili

# Redis 7 — очереди BullMQ.
REDIS_URL=redis://localhost:6379

# Секреты подписи токенов. Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Версия текстов оферты и политики. Под ней записывается согласие на ПДн.
# Меняется вместе с текстами — иначе в базе будет подпись под старой редакцией.
POLICY_VERSION=2026-09-02

# Сколько обратных прокси стоит перед приложением. За балансировщиком
# Timeweb — обычно 1. Пусто = не доверять X-Forwarded-For вовсе.
# Безусловное доверие позволяет любому клиенту назначить себе адрес
# и обойти ограничитель по адресу.
TRUST_PROXY=

# Порог запросов кода с одного адреса в час. По умолчанию 60.
# У мобильных операторов сотни абонентов за одним адресом (CGNAT) — жёсткий
# порог отрежет от входа всех клиентов оператора разом.
OTP_MAX_PER_IP_HOUR=

# Потолок на ВСЕ отправки кода в час. По умолчанию 500. Единственное, что
# реально ограничивает счёт за SMS: список номеров обходит лимит на номер,
# ботнет — лимит на адрес. Срабатывание пишется в лог как авария.
OTP_MAX_PER_HOUR_TOTAL=

# Лимиты выдачи кода на НОМЕР (фича 005). Пара «номер + адрес» — рабочий
# ограничитель: по умолчанию 3 кода в час. Посторонний, знающий чужой номер,
# упирается в него сам, а владелец номера с другого адреса код получает.
# Потолки по номеру — от рассылки с многих адресов: 10 в час и 30 в сутки.
# Каждый отказ — 429 с Retry-After: сколько секунд до освобождения окна.
OTP_MAX_PER_PHONE_IP_HOUR=
OTP_MAX_PER_PHONE_HOUR=
OTP_MAX_PER_PHONE_DAY=

# Сколько взносов в складчину принимаем от одного гостя. По умолчанию 20.
CONTRIBUTIONS_MAX_PER_GUEST=
# Сколько подарков один гость держит в резерве одновременно (по умолчанию 5)
RESERVATIONS_MAX_PER_GUEST=
# Сколько новых переписок в день может начать непроверенный подрядчик
# («холодные» обращения, §13.4). По умолчанию 5.
COLD_OUTREACH_PER_DAY=
# Сколько кадров в общий альбом принимаем от одного гостя. По умолчанию 50.
ALBUM_MAX_PER_GUEST=

# Срок хранения отменённой свадьбы в днях. По умолчанию 365 (План §19.1 —
# 12 месяцев), меньше 30 не бывает: по истечении срока уборка удаляет проект
# со всем содержимым — участниками, гостями, сделками, чатами, задачами.
# Состоявшиеся свадьбы уборка не трогает, они хранятся бессрочно.
WEDDING_ARCHIVE_DAYS=

# Отправка SMS с кодом. Пусто = код уходит в лог (только для разработки).
# В production обязателен настоящий провайдер, иначе сервер не стартует.
# Куда слать неожиданные ошибки. Пусто — не слать никуда и сказать об этом
# в логе: молчаливо «включённый» сбор ошибок хуже выключенного.
SENTRY_DSN=

# Запросов в секунду на токен (§13.4). Работает только при заданном REDIS_URL:
# счётчик в памяти процесса за балансировщиком означал бы лимит, умноженный
# на число процессов. Ноль выключает.
RATE_LIMIT_PER_SECOND=10

# Web Push (VAPID). Сгенерировать: node scripts/gen-vapid.mjs
# Без ключей POST /users/me/push-subscriptions честно отвечает 501,
# а уведомления приходят в приложении.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tili-tili.ru

SMS_PROVIDER=
SMSAERO_EMAIL=
SMSAERO_KEY=
SMSAERO_SIGN=

# S3-совместимое объектное хранилище Timeweb (медиа анкет и альбома).
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Приватные подтверждения оплат — чеки к отметкам оплаты (018-B). Пусто —
# загрузка новых выключена: POST …/receipts отвечает 501 storage_not_configured,
# а уже загруженные файлы читаются и удаляются. db — файл до 512 КБ хранится в
# самой базе и попадает в её резервные копии. Включает владелец (ревью 018, BB-01).
RECEIPTS_STORAGE=
# Квоты на одну свадьбу: файлов (по умолчанию 50) и байт (по умолчанию 26214400 — 25 МБ).
RECEIPTS_MAX_PER_WEDDING=
RECEIPTS_MAX_BYTES_PER_WEDDING=

# Тиль — ИИ-помощник пары (фича 010). Пусто = Тиль честно отвечает «пока без ИИ»
# и сервер стартует и в production. Один протокол на всех провайдеров
# (OpenAI-совместимые chat completions), меняется без кода:
#   openrouter — https://openrouter.ai: много моделей и ключей, есть бесплатные.
#                Нужен TILLY_API_KEY (openrouter.ai/keys). Модель по умолчанию —
#                openrouter/free (маршрутизатор бесплатных моделей); можно назвать
#                свою, через запятую — запасные: google/gemma-4-31b-it:free,
#                nvidia/nemotron-3-super-120b-a12b:free, anthropic/claude-sonnet-4.6 …
#                Бесплатные модели — со своим пределом (~20 запросов в минуту, 50 в
#                сутки на ключ без кредитов): при отказе пара видит «временно без ИИ».
#   ollama     — локальная модель на сервере: ollama pull hermes3 (Hermes 3 от Nous)
#                или любая из ollama.com/library; адрес по умолчанию
#                http://127.0.0.1:11434/v1, ключ не нужен.
#   openai     — любой OpenAI-совместимый сервер (vLLM, llama.cpp, LM Studio):
#                TILLY_BASE_URL и TILLY_MODEL обязательны.
TILLY_PROVIDER=
TILLY_BASE_URL=
TILLY_API_KEY=
TILLY_MODEL=
# Реплик пары в сутки на свадьбу (План §18: 50), таймаут ответа модели (мс),
# длина ответа в токенах и температура. Пусто = 50 / 60000 / 1500 / 0.4.
TILLY_DAILY_LIMIT=
TILLY_TIMEOUT_MS=
TILLY_MAX_TOKENS=
TILLY_TEMPERATURE=
